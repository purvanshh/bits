# ── Backend API ──────────────────────────────────────────────
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fleet?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=24h
ADMIN_PHONE=+919999999999
SMS_PROVIDER=mock

# ── Geocoding (OpenStreetMap Nominatim) ──────────────────────
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
# Identify your application (required by the Nominatim usage policy)
NOMINATIM_USER_AGENT=FleetManagementSystem/1.0 (academic project; your-email@example.com)
NOMINATIM_TIMEOUT_MS=8000
# Public service allows max 1 request/second
NOMINATIM_MIN_INTERVAL_MS=1100

# ── API Gateway ──────────────────────────────────────────────
GATEWAY_PORT=4000
GATEWAY_API_KEY=replace-with-a-long-random-string
GATEWAY_PROXY_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Backend service URLs (all five services currently run in one backend process)
USER_SERVICE_URL=http://localhost:5001
VEHICLE_SERVICE_URL=http://localhost:5001
TELEMETRY_SERVICE_URL=http://localhost:5001
GEOLOCATION_SERVICE_URL=http://localhost:5001
NOTIFICATION_SERVICE_URL=http://localhost:5001

# ── Tests (optional) ─────────────────────────────────────────
# Tests never touch your main database. By default they use the same cluster with
# the database name suffixed "_test" (e.g. fleetdb_test), which is dropped afterwards.
# MONGODB_TEST_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fleetdb_test?retryWrites=true&w=majority

# ── Frontend (Vite dev server reads these from this root .env) ─
# The dev server proxies /api to the gateway and attaches GATEWAY_API_KEY itself,
# so the key is never bundled into browser code.
# GATEWAY_URL=http://localhost:4000
